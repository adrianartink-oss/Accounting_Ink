# Netlify-Umgebungsvariablen.
# In den Netlify Site-Settings setzen (Site configuration → Environment variables).
# Diese Datei ist nur eine Vorlage – echte Werte NICHT ins Repo committen.

# ── Privater Zugang (Access-Gate) ────────────────────────────────────────────
# Aktiviert den Zugangscode-Bildschirm im Frontend (Build-Flag). "on" = aktiv.
VITE_ACCESS_GATE=on
# Geheimnis zum Signieren der Freischalt-Tokens. Lange Zufallszeichenkette.
ACCESS_SIGNING_SECRET=bitte-lange-zufallszeichenkette-eintragen
# Geheimnis zum Schutz der Admin-Funktion (Codes erzeugen/sperren/zurücksetzen).
ADMIN_SECRET=bitte-anderes-langes-geheimnis-eintragen

# ── Managed-AI (optional) ────────────────────────────────────────────────────
# Aktiviert den Server-Proxy für Claude, damit Nutzer keinen eigenen Key brauchen.
# "off" lassen, solange du beim BYO-Key-Modell bleibst (dann zahlst du nichts).
VITE_MANAGED_AI=off
# Dein Anthropic-API-Key. Bleibt serverseitig, gelangt NIE in den Browser.
ANTHROPIC_API_KEY=sk-ant-...

# ── Nur lokal für das Admin-CLI (scripts/codes.mjs) ──────────────────────────
# Basis-URL deiner Netlify-Seite; ADMIN_SECRET wie oben.
ADMIN_BASE_URL=https://accountink.netlify.app
